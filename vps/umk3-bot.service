[Unit]
Description=Ultimate Mortal Kombat 3 - Telegram Mini App Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/umk3
ExecStart=/var/www/umk3/venv/bin/python3 /var/www/umk3/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
