[Unit]
Description=Ultimate Mortal Kombat 3 - Telegram Mini App Bot
After=network.target

[Service]
Type=simple
# Its own unprivileged user: it can read the checkout and .env, and write only data/ (the database)
User=umk3
Group=umk3
WorkingDirectory=/var/www/umk3
ExecStart=/var/www/umk3/venv/bin/python3 /var/www/umk3/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
